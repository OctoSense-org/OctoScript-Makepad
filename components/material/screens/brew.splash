// brew — a coffee-order screen, written as the semantic-vocabulary experiment:
// authored ONLY from WIDGETS.md, by a generator (Claude), to test whether the
// vocabulary as documented is enough to orchestrate a real interactive screen.
// Everything here is state-derived: the summary line, the price, the order
// button's label and the confirmation card all recompute from the store.

fn brew_size_name(i) {
  if i == 0 { return "Small" }
  if i == 1 { return "Medium" }
  return "Large"
}

fn brew_milk_name() {
  if N("brew_oat", 0) == 1 { return "oat milk" }
  if N("brew_whole", 0) == 1 { return "whole milk" }
  return "no milk"
}

fn brew_price() {
  let p = 380 + N("brew_size", 1) * 60
  if N("brew_oat", 0) == 1 { p = p + 70 }
  if N("brew_extra", 0) == 1 { p = p + 90 }
  return p
}

fn brew_money(cents) {
  let c = cents % 100
  let d = (cents - c) / 100
  if c < 10 { return "$" + d + ".0" + c }
  return "$" + d + "." + c
}

fn brew_summary() {
  let shots = N("brew_shots", 2)
  return brew_size_name(N("brew_size", 1)) + " · " + shots + " shot espresso · "
         + brew_milk_name()
}

fn brew_body() {
  let kids = [
    {t:"text", variant:"headlineSmall", text:"Order coffee"},
    caption("Choices below recompute the summary, the price and the button."),

    section("Size"),
    {t:"segmented", items:"Small;Medium;Large", key:"brew_size", selected: N("brew_size", 1)},

    section("Milk"),
    group([
      {t:"chip", variant:"filter", text:"Oat",   key:"brew_oat",   on: N("brew_oat", 0)},
      {t:"chip", variant:"filter", text:"Whole", key:"brew_whole", on: N("brew_whole", 0)},
    ]),

    section("Shots"),
    {t:"slider", key:"brew_shots", value: N("brew_shots", 2), min: 1, max: 4, step: 1},
    caption("Pulling " + N("brew_shots", 2) + " shot(s)"),

    section("Extras"),
    {t:"listitem", label:"Vanilla syrup", supporting:"Adds 90 cents",
     action:"switch", key:"brew_extra", on: N("brew_extra", 0)},
    {t:"divider"},
    {t:"listitem", label:"Make it decaf", supporting:"Same price, less fun",
     action:"switch", key:"brew_decaf", on: N("brew_decaf", 0)},

    section("Your order"),
    {t:"card", variant:"outlined", c:[
      {t:"col", pad: 16, spacing: 4, c:[
        {t:"text", variant:"titleMedium", text: brew_summary()},
        {t:"text", variant:"bodyMedium", text: brew_money(brew_price())},
      ]},
    ]},
  ]

  if N("brew_done", 0) == 0 {
    kids.push({t:"button", variant:"filled", label: "Order · " + brew_money(brew_price()),
               icon:"check", key:"brew_done"})
  }
  if N("brew_done", 0) == 1 {
    kids.push({t:"card", variant:"filled", c:[
      {t:"col", pad: 16, spacing: 8, c:[
        {t:"text", variant:"titleMedium", text:"Order placed"},
        {t:"text", variant:"bodyMedium", text: brew_summary() + " — " + brew_money(brew_price())},
        {t:"button", variant:"text", label:"Start over", key:"brew_done"},
      ]},
    ]})
  }
  return kids
}

// The module result must be a LITERAL object — a top-level fn call as the
// result evaluates to nothing (see kit.splash's note; found the hard way:
// `page(brew_body())` rendered a blank window). Calls are fine INSIDE it.
{t:"scroll", c:[ {t:"col", pad: 16, spacing: 16, c: brew_body()} ]}
