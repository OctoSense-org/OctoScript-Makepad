// Axis delta: accent .magenta over `atro_light` — generated by lab/gates/gen_accent_axes.py.
//
// The hue reaches the INK, which is what a palette is; the ground stays
// the mood's. Tint 85% toward the hue — the strongest pull that
// still clears 4.5:1 on BOTH the page and the composited panel.
// Worst pair 4.52:1

let l0_text     = argb(255, 185,  57, 138)
let l0_soft     = argb(255, 186,  60, 140)
let l0_dim      = argb(255, 186,  60, 140)

let l0_accent   = argb(255, 214,  64, 159)
let l0_bar      = l0_accent
let l0_bar_rail = argb( 38, 128, 128, 128)
let l0_active   = argb( 72, 214, 64, 159)
let l0_go       = l0_accent
