// _palette_photo.octoscript — the `photo` mood, for a card whose page IS an image.
// A DELTA over `_palette_dark`; see `_palette_light.splash` for the contract.
//
// Values from the shipped immersive weather style (a2app/apps/weather/exemplars/
// style-immersive.octoscript). Nearly black and nearly transparent throughout: the
// picture is the surface, so every fill here is something laid ON it rather than
// something replacing it.

let l0_base     = argb(255,   5,   7,  12)   // #05070c for the strip a photo misses
// HEAVIER than every other mood. These cards are read over an arbitrary
// photograph, so the scrim carries all of the legibility.
// The two stops of the shipped immersive exemplar (GradientYView
// #0a0f1a22 -> #05070cf2), restored: the photograph reads at the top and
// the content floats out of near-black at the bottom.
let l0_scrim     = argb(242,   5,   7,  12)   // #05070cf2 bottom stop
// The TOP stop. 22%, not the 13% it was nor the 40% tried and reverted.
//
// At 13% the hero measured 2.59:1 against the photograph, under WCAG AA's 3:1
// for large text. Raising this to 40% did reach 3.37:1 — and flattened the
// upper half of the image into uniform grey. A paired judge preferred the old
// build for exactly that reason ("keeps the photo's depth and lantern glow
// alive"), and it was right: this mood exists to show a photograph.
//
// The scrim was the wrong lever. See `weight_hero` below.
let l0_scrim_top = argb( 56,  10,  15,  26)   // #0a0f1a38 top stop
let l0_sheet    = argb(242,   5,   7,  12)   // #05070cf2 over a map — near-opaque
let l0_fill     = argb( 26, 255, 255, 255)   // #ffffff1a panel fill
let l0_active   = argb( 64, 255, 255, 255)   // #ffffff40 selected chip
let l0_hairline = argb( 34, 255, 255, 255)   // #ffffff22 divider
let l0_soft     = argb(221, 255, 255, 255)   // #ffffffdd secondary
let l0_dim      = argb(136, 255, 255, 255)   // #ffffff88 captions and labels
let l0_up       = argb(255,  90, 240, 130)   // #5af082 a rise
let l0_down     = argb(255, 255, 105, 105)   // #ff6969 a fall
let l0_ondark   = argb(255,   5,   7,  12)   // #05070c text on a lit fill
let l0_danger   = argb(255, 140,  32,  32)   // #8c2020 destructive fill
let l0_danger_i = argb(255, 255, 224, 224)   // #ffe0e0 its ink

// A hairline numeral over a photograph — the largest visual difference
// between the shipped hero and the design-mockup hero after size itself.
// 200, up from 100. A hairline numeral over a photograph is hard to read
// because the STROKE is thin, not only because the contrast ratio is low —
// WCAG itself sets a lower threshold for bold text for this reason. 200 is
// still Extra Light and keeps the cinematic thin-hero look this mood was built
// around; it just puts enough ink down to survive a busy backdrop.
let weight_hero  = 200

// The mockup study's remaining gaps, dialled by the mood (pipeline-v2/REPORT.md):
// hero at photo scale, a dark pane instead of an additive white veil, quieter
// hairlines and value weights, one indigo on a faint rail, line-art glyphs.
let hero_factor  = 1.6
let l0_fill      = argb(133,  13,  18,  28)   // #0d121c85 dark translucent pane
let l0_hairline  = argb( 20, 255, 255, 255)   // #ffffff14 quieter divider
let weight_semi  = 400
let l0_bar       = argb(255, 109, 121, 240)   // #6d79f0 the mockup's indigo
let l0_bar_rail  = argb( 41, 255, 255, 255)   // #ffffff29 faint rail
let icon_mono    = 1
let panel_inset  = 10   // the mockup's floating inset card

// The gap frames the photograph here, so the card's air is kept whole.
let air_factor = 1
