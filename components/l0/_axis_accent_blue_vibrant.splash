// Axis delta: accent .blue over `vibrant` — generated by lab/gates/gen_accent_axes.py.
//
// The hue reaches the INK, which is what a palette is; the ground stays
// the mood's. Tint 65% toward the hue — the strongest pull that
// still clears 4.5:1 on BOTH the page and the composited panel.
// Worst pair 4.52:1  ·  bar/chip fill below 3:1 on this mood

let l0_text     = argb(255, 106, 164, 240)
let l0_soft     = argb(255, 103, 158, 231)
let l0_dim      = argb(255, 103, 158, 232)

let l0_accent   = argb(255,  26, 115, 232)
let l0_bar      = l0_accent
let l0_bar_rail = argb( 38, 128, 128, 128)
let l0_active   = argb( 72, 26, 115, 232)
let l0_go       = l0_accent
