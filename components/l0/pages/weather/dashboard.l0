view root Photo(src: scene, pad: .page) {
  page_header
  saved
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed { TextBody(text: copy.offline) }
  Card {
    Row(align: .center, gap: 16) {
      Col(width: .fill, gap: 6) {
        TextCaption(text: now.cond)
        TextHero(value: now.temp, unit: units, on_tap: toggle_units)
        TextCaption(glyph: "≈", value: now.feels, unit: units)
      }
      WeatherIcon(cond: now.cond, size: .hero)
    }
  }
  details
  forecast
  sunmoon
  cloudfield
  airfield
}
view page_header Row(align: .center, gap: 12) {
  Col(width: .fill) { TextTitle(text: place.name) TextCaption(text: now.cond) }
  Chip(text: copy.plus, on_tap: add_city, value: "1")
}
