// Axis delta: accent .cyan over `vibrant` — generated by lab/gates/gen_accent_axes.py.
//
// The hue reaches the INK, which is what a palette is; the ground stays
// the mood's. Tint 100% toward the hue — the strongest pull that
// still clears 4.5:1 on BOTH the page and the composited panel.
// Worst pair 4.52:1

let l0_text     = argb(255,  18, 181, 201)
let l0_soft     = argb(255,  21, 171, 192)
let l0_dim      = argb(255,  21, 171, 192)

let l0_accent   = argb(255,  18, 181, 201)
let l0_bar      = l0_accent
let l0_bar_rail = argb( 38, 128, 128, 128)
let l0_active   = argb( 72, 18, 181, 201)
let l0_go       = l0_accent

// accent-as-seed: with a seeded ground, _derive_color re-solves the
// ink against THAT ground in-kit (unrolled five-step contrast search)
// instead of keeping this fragment's mood-solved literals.
let seed_hue_on = 1
let seed_hue_r  = 18
let seed_hue_g  = 181
let seed_hue_b  = 201
