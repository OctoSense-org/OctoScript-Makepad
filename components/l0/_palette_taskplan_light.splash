// the kit's most-reused two-stop gradient — content cards take it
let l0_card_1 = argb(255, 255, 255, 255)
let l0_card_2 = argb(255, 245, 246, 246)
// This pack's cards are WHITE on a near-white page, so the ink they are read
// with is the pack's own dark text — not the white the base declares for
// dark-card packs. Caught by audit_theme before first render: white-on-white
// at 1.00, the exact CaMo-light class of defect this knob exists for.
let l0_card_ink = argb(255, 17, 25, 39)
