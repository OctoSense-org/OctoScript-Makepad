use mod.std.*
use mod.hub

hub.set_run_items([
    {
        name: "octos-ux-image-studio"
        package_name: "kit-host"
        in_studio: true
        on_run: fn(id) {
            hub.run(
                {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string()
                 "STUDIO_CRATE": "kit-host" "BEAUTY_REQUEST": "../lab/ux-image/current-request.json"},
                "cargo",
                ["run" "-p" "kit-host" "--bin" "beauty-host" "--release" "--message-format=json"
                 "--" "--message-format=json" "--stdin-loop"]
            )
        }
    }
    {
        name: "splash-beauty-studio-host"
        package_name: "kit-host"
        in_studio: true
        on_run: fn(id) {
            hub.run(
                {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string()
                 "STUDIO_CRATE": "kit-host" "BEAUTY_REQUEST": "../lab/sketch/work/beauty-request.json"},
                "cargo",
                ["run" "-p" "kit-host" "--bin" "beauty-host" "--release" "--message-format=json"
                 "--" "--message-format=json" "--stdin-loop"]
            )
        }
    }
    {
        name: "splash-beauty-host"
        package_name: "kit-host"
        in_studio: false
        on_run: fn(id) {
            hub.run(
                {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string()
                 "STUDIO_CRATE": "kit-host" "BEAUTY_REQUEST": "../lab/sketch/work/beauty-request.json"},
                "cargo",
                ["run" "-p" "kit-host" "--bin" "beauty-host" "--release" "--message-format=json"
                 "--" "--message-format=json"]
            )
        }
    }
])
